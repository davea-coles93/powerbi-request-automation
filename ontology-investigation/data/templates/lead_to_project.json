{
  "template_meta": {
    "id": "lead_to_project",
    "name": "Lead to Project Pipeline",
    "description": "End-to-end process from opportunity identification through proposal, SOW, and project kickoff. Covers BD, presales estimation, and contract negotiation.",
    "icon": "\ud83c\udfaf",
    "category": "Operations"
  },
  "systems": [
    {
      "id": "mieruka",
      "name": "Mieruka",
      "type": "Other",
      "vendor": "Custom (Toyota Connected)",
      "reliability_default": "Medium",
      "integration_status": "Connected",
      "notes": "Custom project governance tool built on PowerApps. Performance issues cause users to work offline in Excel. Budget tracking, resource allocation, forecasting done here but often stale. Being replaced by this programme."
    },
    {
      "id": "jira",
      "name": "Jira",
      "type": "Other",
      "vendor": "Atlassian",
      "reliability_default": "High",
      "integration_status": "Connected",
      "notes": "Primary project management tool. Stories, sprints, velocity tracked here. API connected but data quality depends on team discipline."
    },
    {
      "id": "excel",
      "name": "Excel Spreadsheets",
      "type": "Spreadsheet",
      "vendor": "Microsoft",
      "reliability_default": "Low",
      "integration_status": "Manual Extract",
      "notes": "Heavy offline usage due to Mieruka performance. Forecasts, resource plans, status reports all maintained in Excel. Version control nightmare, multiple sources of truth."
    },
    {
      "id": "sharepoint",
      "name": "SharePoint",
      "type": "Other",
      "vendor": "Microsoft",
      "reliability_default": "Medium",
      "integration_status": "Connected",
      "notes": "Document management for SOWs, contracts, architecture docs. Metadata not consistently applied, making it hard to link documents to projects automatically."
    },
    {
      "id": "oracle",
      "name": "Oracle (Finance)",
      "type": "ERP",
      "vendor": "Oracle",
      "reliability_default": "High",
      "integration_status": "Connected",
      "notes": "System of record for actuals, revenue recognition, and project codes. Reliable but complex chart of accounts makes ad-hoc reporting difficult."
    },
    {
      "id": "hibob",
      "name": "HiBob",
      "type": "Other",
      "vendor": "HiBob",
      "reliability_default": "High",
      "integration_status": "Connected",
      "notes": "HR system for time-off, employee data. Well-structured API but limited to HR scope."
    }
  ],
