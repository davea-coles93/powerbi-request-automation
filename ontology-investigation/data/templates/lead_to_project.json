      "perspective_ids": [
        "management",
        "financial"
      ]
    }
  ],
  "processes": [
    {
      "id": "proc_lead_to_project",
      "name": "Lead to Project Pipeline",
      "description": "End-to-end process from opportunity identification through to project kickoff",
      "steps": [
        {
          "id": "step_lead_capture",
          "sequence": 1,
          "name": "Capture Lead / Opportunity",
          "description": "BD or account manager identifies a new opportunity and creates a lead in Jira presales board",
          "perspective_id": "management",
          "actor": "Business Development",
          "consumes_attribute_ids": [],
          "produces_attribute_ids": [
            "attr_lead_status",
            "attr_pipeline_value"
          ],
          "uses_metric_ids": [],
          "crystallizes_attribute_ids": [],
          "depends_on_step_ids": [],
          "perspective_level": "management",
          "estimated_duration_minutes": 30,
          "automation_potential": "Medium",
          "systems_used_ids": [
            "jira",
            "excel"
          ],
          "waste_category": "Manual Data Entry",
          "manual_effort_percentage": 80
        },
        {
          "id": "step_presales_estimate",
          "sequence": 2,
          "name": "Create Presales Estimate",
          "description": "Solution architect and presales create effort estimate, demand by role, and gross margin estimate in Excel",
          "perspective_id": "management",
          "actor": "Presales / Solution Architect",
          "consumes_attribute_ids": [
            "attr_lead_status"
          ],
          "produces_attribute_ids": [
            "attr_presales_estimate",
            "attr_demand_by_role",
            "attr_gm_estimate"
          ],
          "uses_metric_ids": [],
          "crystallizes_attribute_ids": [],
          "depends_on_step_ids": [
            "step_lead_capture"
          ],
          "perspective_level": "management",
          "estimated_duration_minutes": 480,
          "automation_potential": "Low",
          "systems_used_ids": [
            "excel"
          ],
          "waste_category": null,
          "manual_effort_percentage": 95
        },
        {
          "id": "step_qualify_lead",
          "sequence": 3,
          "name": "Qualify & Assess Probability",
          "description": "BD assesses conversion probability and updates pipeline value based on client engagement",
          "perspective_id": "management",
          "actor": "Business Development",
          "consumes_attribute_ids": [
            "attr_presales_estimate",
            "attr_demand_by_role"
          ],
          "produces_attribute_ids": [
            "attr_conversion_prob"
          ],
          "uses_metric_ids": [
            "kpi_pipeline_health"
          ],
          "crystallizes_attribute_ids": [],
          "depends_on_step_ids": [
            "step_presales_estimate"
          ],
          "perspective_level": "management",
          "estimated_duration_minutes": 60,
          "automation_potential": "Low",
          "systems_used_ids": [
            "excel",
            "jira"
          ],
          "waste_category": null,
          "manual_effort_percentage": 90
        },
        {
          "id": "step_create_sow",
          "sequence": 4,
          "name": "Create & Sign SOW",
          "description": "PM drafts SOW using presales estimate, gets client sign-off, stores in SharePoint",
          "perspective_id": "management",
