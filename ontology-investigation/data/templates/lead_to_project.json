    }
  ],
  "measures": [
    {
      "id": "meas_budget_variance",
      "name": "Budget Variance",
      "description": "Difference between approved budget and actual spend",
      "logic": "Budget minus actuals. Positive = under budget.",
      "formula": "attr_budget_approved - attr_actuals",
      "input_attribute_ids": [
        "attr_budget_approved",
        "attr_actuals"
      ],
      "input_measure_ids": [],
      "perspective_ids": [
        "financial",
        "management"
      ]
    },
    {
      "id": "meas_resource_utilization",
      "name": "Resource Utilization",
      "description": "Ratio of allocated/billed time to available time",
      "logic": "Approved hours divided by available capacity",
      "formula": "attr_hours_approved / attr_availability \u00d7 100",
      "input_attribute_ids": [
        "attr_hours_approved",
        "attr_availability",
        "attr_time_off"
      ],
      "input_measure_ids": [],
      "perspective_ids": [
        "management"
      ]
    },
    {
      "id": "meas_revenue_per_project",
      "name": "Revenue per Project",
      "description": "Total recognized revenue for a project",
      "logic": "Oracle revenue actuals for the project code",
      "formula": "SUM(attr_revenue) WHERE project_code",
      "input_attribute_ids": [
        "attr_revenue",
        "attr_project_code"
      ],
      "input_measure_ids": [],
      "perspective_ids": [
        "financial"
      ]
    },
    {
      "id": "meas_weighted_pipeline",
      "name": "Weighted Pipeline Value",
      "description": "Total pipeline value weighted by conversion probability",
      "logic": "Sum of (pipeline value \u00d7 probability) for all active leads",
      "formula": "SUM(attr_pipeline_value \u00d7 attr_conversion_prob / 100)",
      "input_attribute_ids": [
        "attr_pipeline_value",
        "attr_conversion_prob"
      ],
      "input_measure_ids": [],
      "perspective_ids": [
        "financial",
        "management"
      ]
    },
    {
      "id": "meas_lead_conversion_rate",
      "name": "Lead Conversion Rate",
      "description": "Percentage of leads that convert to active projects",
      "logic": "Won leads divided by total qualified leads",
      "formula": "COUNT(attr_lead_status = 'Won') / COUNT(attr_lead_status IN ('Won','Lost')) \u00d7 100",
      "input_attribute_ids": [
        "attr_lead_status"
      ],
      "input_measure_ids": [],
      "perspective_ids": [
        "management"
      ]
    },
    {
      "id": "meas_resource_capacity",
      "name": "Resource Capacity",
      "description": "Available capacity after accounting for leave and existing allocations",
      "logic": "Total availability minus time-off minus current allocation",
      "formula": "attr_availability - attr_time_off - attr_allocation",
      "input_attribute_ids": [
        "attr_availability",
        "attr_time_off",
        "attr_allocation"
      ],
      "input_measure_ids": [],
      "perspective_ids": [
        "management"
      ]
    },
    {
      "id": "meas_forecast_vs_budget",
      "name": "Forecast vs Budget",
      "description": "How the current forecast compares to original budget",
      "logic": "Forecast as percentage of budget",
      "formula": "attr_forecast_spend / attr_budget_approved \u00d7 100",
      "input_attribute_ids": [
        "attr_forecast_spend",
        "attr_budget_approved"
      ],
      "input_measure_ids": [],
      "perspective_ids": [
        "financial"
      ]
    }
  ],
  "metrics": [
    {
      "id": "kpi_resource_utilization",
